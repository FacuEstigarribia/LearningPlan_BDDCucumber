<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.posteducation.cucumber.carina.demo.gui.database.mappers.IUserOrderMapper">

    <sql id="getOrders">
        <![CDATA[
            SELECT
                id AS ORDER_ID,
                user_id AS USER_ID,
                product_name AS PRODUCT_NAME,
                product_price AS PRODUCT_PRICE
            FROM
                userorders
        ]]>
    </sql>


    <select id="findById" resultMap="UserOrderResultMap">
        SELECT * FROM orders WHERE id = #{id}
    </select>

    <select id="findOrdersByUserId" resultMap="UserOrderResultMap">
        <include refid="getOrders" />
        <![CDATA[
            WHERE user_id = #{userId}
        ]]>
    </select>

    <resultMap type="com.solvd.posteducation.cucumber.carina.demo.gui.database.models.UserOrder"
               id="UserOrderResultMap" autoMapping="false">
        <id column="ORDER_ID" property="id"/>
        <result column="USER_ID" property="userId"/>
        <result column="PRODUCT_NAME" property="productName"/>
        <result column="PRODUCT_PRICE" property="productPrice"/>
    </resultMap>

</mapper>